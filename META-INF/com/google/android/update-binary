#!/sbin/sh

#-----------------------------------------------------------------------
# Purpose: Repartitioning the boot partition with a GPT backup via ZIP in Recovery
# Version: 1.3 (Infinix Note 10 Pro X695C -deviant- FIXED)
# Author: isus203
#-----------------------------------------------------------------------

# ======================================================================
#   ✅ INFINIX NOTE 10 PRO (X695) - BOOT 32MB → 96MB
# ======================================================================

# 1. DEVICE - INFINIX use UFS
DEVICE="/dev/block/sdc"

# 2. PATHS - FIXED /sdcard (external_sd error)
EXTERNAL_PATH="/sdcard"

# 3. PARTITION NAMES - VERIFIED
BOOT_A_NAME="boot_a"      # sdc34
BOOT_B_NAME="boot_b"      # sdc50

# 4. NUMBERS - FROM YOUR GPT TABLE
OLD_BOOT_A_NUM="34"       # boot_a (keep)
OLD_BOOT_B_NUM="50"       # boot_b (keep)
NEW_VENDOR_BOOT_A_NUM="35" # vendor_boot_a (DELETE)
NEW_VENDOR_BOOT_B_NUM="51" # vendor_boot_b (DELETE)
NEW_BOOT_A_NUM="34"       # new boot_a 96MB
NEW_BOOT_B_NUM="50"       # new boot_b 96MB

# 5. SECTORS - YOUR EXACT GPT SECTORS (96MB)
BOOT_A_SECTORS="158976:183551"    # sdc34 → 96MB
BOOT_B_SECTORS="267520:292095"    # sdc50 → 96MB

# GPT OVERLAP = NORMAL INFINIX UFS (ignore warnings)
FORCE_GPT="yes"

# ======================================================================
#           ⛔ DO NOT EDIT BELOW (SCRIPT CODE)
# ======================================================================

OUTFD="/proc/self/fd/$2"
ZIPFILE="$3"

SGDISK="/tmp/sgdisk"
BOOT_IMG="/tmp/boot.img"
LOGFILE="$EXTERNAL_PATH/repartition_note10pro.log"
GPT_SDCARD="$EXTERNAL_PATH/gpt_note10pro_backup.bin"
BACKUP_DIR="/tmp/backup"
BACKUP_GPT="/tmp/backup/gpt_backup.bin"
GPT_BACKUP_ZIP="$EXTERNAL_PATH/Note10Pro_96MB_Backup_$(date '+%Y%m%d_%H%M%S').zip"

ui_print() {
    echo -e "ui_print $1
ui_print" >> "$OUTFD"
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOGFILE" 2>/dev/null
}

display_banner() {
    ui_print ""
    ui_print "==============================================="
    ui_print "     Infinix Note 10 Pro X695C (Deviant)       "
    ui_print "                By excaliburXD                 "
    ui_print "Original Script By isus203 modify by exaliburXD"
    ui_print "               FIXED v1.4 (2026)               "
    ui_print "==============================================="
    ui_print " DEVICE: $DEVICE"
    ui_print " boot_a: sdc34 → 96MB ($BOOT_A_SECTORS)"
    ui_print " boot_b: sdc50 → 96MB ($BOOT_B_SECTORS)"
    ui_print " GPT overlap = NORMAL Infinix UFS"
    ui_print ""
}

extract_package() {
    ui_print "Extracting ZIP..."
    mkdir -p /tmp /tmp/backup "$EXTERNAL_PATH"
    unzip -o "$ZIPFILE" -d /tmp
}

check_files() {
    for f in "$SGDISK" "$BOOT_IMG"; do
        [ ! -f "$f" ] && ui_print "ERROR: $f missing!" && exit 1
    done
}

set_permissions() {
    ui_print "Setting permissions..."
    chmod 755 "$SGDISK"
    chmod 644 "$BOOT_IMG"
}

backup_gpt() {
    ui_print "Creating GPT backup..."
    "$SGDISK" -b "$BACKUP_GPT" "$DEVICE"
    cp "$BACKUP_GPT" "$GPT_SDCARD"
    ui_print "GPT backup: $GPT_SDCARD"
    
    # Create restore ZIP
    mkdir -p "$BACKUP_DIR/META-INF/com/google/android"
    cat > "$BACKUP_DIR/META-INF/com/google/android/update-script" << EOF
# Note 10 Pro Restore Original
EOF
    
    cat > "$BACKUP_DIR/META-INF/com/google/android/update-binary" << 'EOF'
#!/sbin/sh
ui_print() { echo -e "ui_print $1
ui_print" >> /proc/self/fd/$2; }
ui_print "Note 10 Pro - Restore Original Boot"
unzip -o "$3" -d /tmp
chmod 755 /tmp/sgdisk
/tmp/sgdisk -g=/tmp/gpt_backup.bin /dev/block/sdc
ui_print "Original boot restored!"
EOF
    
    (cd "$BACKUP_DIR" && zip -r "$GPT_BACKUP_ZIP" *) >/dev/null
    ui_print "Full restore ZIP: $GPT_BACKUP_ZIP"
}

repartition_boot() {
    ui_print "Resizing boot partitions (96MB)..."
    
    # Delete vendor_boot (FORCE ignore overlap warning)
    "$SGDISK" "$DEVICE" --delete=$NEW_VENDOR_BOOT_A_NUM
    "$SGDISK" "$DEVICE" --delete=$NEW_VENDOR_BOOT_B_NUM
    
    # Create new 96MB boot partitions
    "$SGDISK" "$DEVICE" --new=$NEW_BOOT_A_NUM:$BOOT_A_SECTORS --change-name=$NEW_BOOT_A_NUM:"$BOOT_A_NAME" --typecode=$NEW_BOOT_A_NUM:0700
    "$SGDISK" "$DEVICE" --new=$NEW_BOOT_B_NUM:$BOOT_B_SECTORS --change-name=$NEW_BOOT_B_NUM:"$BOOT_B_NAME" --typecode=$NEW_BOOT_B_NUM:0700
    
    # Force write (ignore GPT overlap - Infinix OEM normal)
    "$SGDISK" "$DEVICE" --write-table
    
    ui_print "Boot resize COMPLETE! (96MB)"
}

flash_firmware() {
    ui_print "Flashing boot image..."
    dd if="$BOOT_IMG" of="/dev/block/by-name/$BOOT_A_NAME" 2>>"$LOGFILE"
    dd if="$BOOT_IMG" of="/dev/block/by-name/$BOOT_B_NAME" 2>>"$LOGFILE"
    ui_print "Boot flashed successfully!"
}

# EXECUTE
display_banner
extract_package
check_files
set_permissions
backup_gpt
repartition_boot
flash_firmware

ui_print ""
ui_print "🎉 SUCCESS! Resize Boot to 96MB"
ui_print "💾 Backup+Restore: $GPT_BACKUP_ZIP"
ui_print "🔄 Reboot recommended"
ui_print "🔄Reboot Recovery"
